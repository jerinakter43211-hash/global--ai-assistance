# Server-only production configuration. Never commit real secrets.
ADMIN_EMAIL=jerinakter43211@gmail.com

# Auth.js / Google Admin Login
AUTH_SECRET=generate-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# AI
OPENAI_API_KEY=your-server-side-openai-api-key
OPENAI_MODEL=gpt-6-luna

# Persistent PostgreSQL database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 32-byte AES-256-GCM key encoded as 64 hexadecimal characters.
PRIVATE_DATA_ENCRYPTION_KEY=generate-64-hex-characters
